# 本地渲染、模板审计、解包、layout、QA 缓存与中间产物
.work/
/.tmp/
/.ppt_master_inputs/
node_modules/
.venv/
__pycache__/
*.pyc

# 网站构建产物与虚拟环境（web/）
/web/_build/
/web/.venv/
/web/__pycache__/
/web/scripts/__pycache__/
# web/docs/ 下由 link_content.py 生成的软链接内容（手写页面 index.md/teacher.md 仍跟踪）
/web/docs/course/
/web/docs/lessons/
/web/docs/downloads/

# inspection / layout 自动产物
*.ndjson

# 本机凭据注入与客户端配置
